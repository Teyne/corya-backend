# ========================================
# Corya Backend — Variables d'environnement
# ========================================
# Copier ce fichier en .env.local et remplir avec les vraies valeurs.
# NE JAMAIS commit .env.local.

# ---- Environnement ----
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=debug
# Origines autorisees par le middleware CORS du backend.
# Jamais "*". En dev : le front Next tourne sur 3001 (cf. docs/architecture.md).
# Plusieurs origines possibles, separees par des virgules.
CORS_ORIGIN=http://localhost:3001

# ---- Supabase ----
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_JWT_SECRET=...

# ---- Retell AI ----
# OBLIGATOIRE. Sert aussi de secret HMAC pour verifier la signature des
# webhooks : Retell signe avec la cle API, il n'y a pas de secret dedie.
# La verification passe par retell-sdk, leur format de signature n'etant pas
# documente publiquement.
RETELL_API_KEY=key_...
# Fenetre de tolerance sur le timestamp de la signature Retell, en SECONDES
# (le timestamp envoye par Retell est lui en millisecondes).
# Rejet bidirectionnel : trop vieux = rejeu, trop en avance = horloge
# desynchronisee. Entier entre 30 et 3600, defaut 300.
# Defense en profondeur uniquement : ce controle ne s'applique que si le
# header a la forme attendue, sinon la decision revient entierement au SDK.
RETELL_SIGNATURE_MAX_AGE_SECONDS=300

# ---- SMTP Infomaniak ----
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@corya.ch
SMTP_PASSWORD=...
SMTP_FROM_NAME=Corya
SMTP_FROM_EMAIL=noreply@corya.ch

# ---- SMS (MessageBird ou Twilio) ----
SMS_PROVIDER=messagebird
MESSAGEBIRD_API_KEY=...
MESSAGEBIRD_ORIGINATOR=Corya

# ---- Session 4 : resilience worker + alerting ops ----
# Seuil (secondes) au-dela duquel claim_jobs recupere un job 'processing'
# comme zombie. Doit rester STRICTEMENT INFERIEUR a la fenetre du cron
# requeue_stuck_jobs (10 min) : voir migration 20260801000000.
JOB_STALE_AFTER_SECONDS=300
# Periode du tick "alive" du worker (ms). Le tick est ecrit par un
# setInterval INDEPENDANT de la boucle de polling, pour distinguer
# "process mort" (last_seen_at ancien) de "boucle bloquee"
# (last_poll_at ancien mais last_seen_at frais).
WORKER_HEARTBEAT_INTERVAL_MS=10000
# Seuil (secondes) d'alerte sur worker_heartbeats.last_seen_at.
# Le seuil sur last_poll_at (180 s) est hard-code cote poller.
WORKER_STALE_THRESHOLD_SECONDS=60
# Nombre de jobs pending vieux de plus de 5 min au-dessus duquel on tire
# l'alerte jobs_backlog. 20 = compromis entre bruit et signal.
JOBS_BACKLOG_ALERT_THRESHOLD=20
# Destinataire des alertes ops. Vide en dev/test (les alertes sont juste
# loguees). REQUIS en production : le boot echoue sinon.
# Prod : teyne17@gmail.com.
ALERT_EMAIL=
# Fenetre de deduplication en memoire (ms) : au plus 1 alerte par TYPE
# par fenetre. Un worker qui boucle sur une erreur ne DOIT PAS envoyer
# 1800 emails/heure. Defaut 15 min.
ALERT_DEDUP_WINDOW_MS=900000
# Master switch. false = alertes desactivees + WARN explicite au boot
# (API et worker) pour eviter tout doute sur l'etat operationnel.
ALERT_ENABLED=true

# ---- Session 4 vague 3 : timeouts I/O externes + retry SMTP ----
# Chaque appel externe est borne : sans ca, une requete supabase qui pend
# occupe un slot de worker indefiniment. Voir src/utils/timeout.ts.
TIMEOUT_DB_MS=5000
TIMEOUT_STORAGE_MS=30000
TIMEOUT_PDF_MS=15000
TIMEOUT_SMTP_MS=30000
TIMEOUT_RETELL_MS=10000
# Retry SMTP interne AU SEIN d'un job : 3 tentatives, delais 1s / 5s / 30s.
# Erreurs transitoires (ETIMEDOUT, ECONNREFUSED, 421/450/451/452) -> retry.
# Erreurs permanentes (550/551/553/554) -> dead_letter direct, sans brûler
# les 5 tentatives sur une adresse cabinet qui n'existe pas.
SMTP_RETRY_ATTEMPTS=3
SMTP_RETRY_DELAYS_MS=1000,5000,30000

# ---- Session 4 vague 4 : health endpoints + rate limiting ----
# Token protegeant GET /health/deep. Sans token valide -> 404 (on ne
# revele pas l'existence de l'endpoint). REQUIS en production, laisser
# vide en dev/test. Longueur min: 16 chars. Genere-toi une valeur random.
HEALTH_DEEP_TOKEN=
# TTL (ms) du cache in-memory sur /health/deep. Un ping monitoring toutes
# les 3 min avec cache 60 s = 1 vraie execution sur 3 pings, protege
# Supabase et Storage d'un appel en rafale.
HEALTH_DEEP_CACHE_MS=60000
# Rate limit GLOBAL sur /webhooks/* (pas par IP, cf commentaire dans
# src/middleware/rate-limit.ts : Retell tape depuis un pool restreint,
# per-IP bloquerait le seul legitime en rafale de retry).
RATE_LIMIT_WEBHOOK_MAX=300
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000
# Nombre de sauts reverse-proxy de confiance (Jelastic front). Numerique
# uniquement — 'true' fait confiance a tous les hops et n'est jamais
# approprie. Meme sans rate-limit par IP, sert a ce que pino-http log
# la vraie IP source au lieu de l'IP du proxy.
TRUST_PROXY_HOPS=1

# ---- Frontend admin.corya.ch ----
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_API_URL=http://localhost:3000

# ---- Monitoring ----
BETTERSTACK_SOURCE_TOKEN=...

# ---- Purges nLPD ----
AUDIO_RETENTION_HOURS=48
TRANSCRIPT_RETENTION_DAYS=7
APPEL_RETENTION_MONTHS=24

# ---- Worker post-appel (session 3) ----
# Identifiant stable du worker, ecrit dans jobs.locked_by au claim. Utile
# quand plusieurs nodes tournent en parallele (Jelastic scale-out) et qu'on
# doit tracer quel node a pris un job qui a fini en dead_letter. Optionnel :
# genere automatiquement si absent (ex: worker-<pid>-<hostname>).
WORKER_ID=worker-local
# Frequence de polling de la file jobs (ms). Retell nous donne ~10s pour
# repondre au webhook ET envoyer l'email : un poll trop lent mange le budget.
# Apres un batch non vide, le worker re-drague immediatement sans attendre
# cet intervalle (voir src/workers/job-worker.ts).
JOB_POLL_INTERVAL_MS=2000
# Nombre max de jobs pris par appel a claim_jobs(). Le worker traite ce batch
# en parallele. 5 est un compromis contention DB / debit.
JOB_BATCH_SIZE=5
FILE_DELETION_BATCH_SIZE=5
FILE_DELETION_POLL_INTERVAL_MS=10000
FILE_DELETION_STALE_AFTER_SECONDS=300
# URL du back-office admin (app.corya.ch) utilisee dans les emails de recap
# pour le lien "voir le detail". En dev, pointe sur le Next local :3001.
ADMIN_APP_URL=http://localhost:3001
