# ========================================
# Corya Backend — Variables d'environnement
# ========================================
# Copier ce fichier en .env.local et remplir avec les vraies valeurs.
# NE JAMAIS commit .env.local.

# ---- Environnement ----
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=debug
# Origines autorisees par le middleware CORS du backend.
# Jamais "*". En dev : le front Next tourne sur 3001 (cf. docs/architecture.md).
# Plusieurs origines possibles, separees par des virgules.
CORS_ORIGIN=http://localhost:3001

# ---- Supabase ----
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_JWT_SECRET=...

# ---- Retell AI ----
# OBLIGATOIRE. Sert aussi de secret HMAC pour verifier la signature des
# webhooks : Retell signe avec la cle API, il n'y a pas de secret dedie.
# La verification passe par retell-sdk, leur format de signature n'etant pas
# documente publiquement.
RETELL_API_KEY=key_...
# Fenetre de tolerance sur le timestamp de la signature Retell, en SECONDES
# (le timestamp envoye par Retell est lui en millisecondes).
# Rejet bidirectionnel : trop vieux = rejeu, trop en avance = horloge
# desynchronisee. Entier entre 30 et 3600, defaut 300.
# Defense en profondeur uniquement : ce controle ne s'applique que si le
# header a la forme attendue, sinon la decision revient entierement au SDK.
RETELL_SIGNATURE_MAX_AGE_SECONDS=300

# ---- SMTP Infomaniak ----
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@corya.ch
SMTP_PASSWORD=...
SMTP_FROM_NAME=Corya
SMTP_FROM_EMAIL=noreply@corya.ch

# ---- SMS (MessageBird ou Twilio) ----
SMS_PROVIDER=messagebird
MESSAGEBIRD_API_KEY=...
MESSAGEBIRD_ORIGINATOR=Corya

# ---- Frontend admin.corya.ch ----
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_API_URL=http://localhost:3000

# ---- Monitoring ----
BETTERSTACK_SOURCE_TOKEN=...

# ---- Purges nLPD ----
AUDIO_RETENTION_HOURS=48
TRANSCRIPT_RETENTION_DAYS=7
APPEL_RETENTION_MONTHS=24

# ---- Worker post-appel (session 3) ----
# Identifiant stable du worker, ecrit dans jobs.locked_by au claim. Utile
# quand plusieurs nodes tournent en parallele (Jelastic scale-out) et qu'on
# doit tracer quel node a pris un job qui a fini en dead_letter. Optionnel :
# genere automatiquement si absent (ex: worker-<pid>-<hostname>).
WORKER_ID=worker-local
# Frequence de polling de la file jobs (ms). Retell nous donne ~10s pour
# repondre au webhook ET envoyer l'email : un poll trop lent mange le budget.
# Apres un batch non vide, le worker re-drague immediatement sans attendre
# cet intervalle (voir src/workers/job-worker.ts).
JOB_POLL_INTERVAL_MS=2000
# Nombre max de jobs pris par appel a claim_jobs(). Le worker traite ce batch
# en parallele. 5 est un compromis contention DB / debit.
JOB_BATCH_SIZE=5
# URL du back-office admin (app.corya.ch) utilisee dans les emails de recap
# pour le lien "voir le detail". En dev, pointe sur le Next local :3001.
ADMIN_APP_URL=http://localhost:3001
