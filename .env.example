# ========================================
# Corya Backend — Variables d'environnement
# ========================================
# Copier ce fichier en .env.local et remplir avec les vraies valeurs.
# NE JAMAIS commit .env.local.

# ---- Environnement ----
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=debug

# ---- Supabase ----
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_JWT_SECRET=...

# ---- Retell AI ----
RETELL_API_KEY=key_...
RETELL_WEBHOOK_SECRET=whsec_...

# ---- SMTP Infomaniak ----
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@corya.ch
SMTP_PASSWORD=...
SMTP_FROM_NAME=Corya
SMTP_FROM_EMAIL=noreply@corya.ch

# ---- SMS (MessageBird ou Twilio) ----
SMS_PROVIDER=messagebird
MESSAGEBIRD_API_KEY=...
MESSAGEBIRD_ORIGINATOR=Corya

# ---- Frontend admin.corya.ch ----
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_API_URL=http://localhost:3000

# ---- Monitoring ----
BETTERSTACK_SOURCE_TOKEN=...

# ---- Purges nLPD ----
AUDIO_RETENTION_HOURS=48
TRANSCRIPT_RETENTION_DAYS=7
APPEL_RETENTION_MONTHS=24
