{
  "name": "@corya/backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.15.0",
  "description": "Corya backend api.corya.ch — webhooks Retell, PDF, email, purges nLPD.",
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-templates.mjs",
    "artifact:create": "node scripts/create-release-artifact.mjs",
    "artifact:verify": "node scripts/verify-release-artifact.mjs",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "preflight:jelastic": "node scripts/preflight-jelastic.mjs",
    "smoke:puppeteer": "node scripts/smoke-puppeteer.mjs",
    "diag:retell": "tsx scripts/diagnose-retell-signature.ts",
    "test:email-pipeline": "tsx scripts/test-email-pipeline.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "nodemailer": "^10.1.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "puppeteer": "^25.13.0",
    "retell-sdk": "^6.2.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.0.0",
    "eslint": "^10.12.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "puppeteer@25.4.0": true,
    "esbuild@0.28.1": true
  }
}
